@model LoginandRegisterMVC.Models.User

@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="form-card">
    <h2 class="gradient-text">Create Account</h2>
    
    <form asp-action="Register" method="post">
        @Html.AntiForgeryToken()
        
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        
        <div class="form-group-modern">
            <label asp-for="UserId">User ID</label>
            <input asp-for="UserId" class="form-control" placeholder="Choose a unique user ID" />
            <span asp-validation-for="UserId" class="text-danger"></span>
        </div>

        <div class="form-group-modern">
            <label asp-for="Username">Username</label>
            <input asp-for="Username" class="form-control" placeholder="Enter your full name" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <div class="form-group-modern">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" class="form-control" type="password" placeholder="Create a strong password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        
        <div class="form-group-modern">
            <label asp-for="ConfirmPassword">Confirm Password</label>
            <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Re-enter your password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="form-group-modern">
            <label asp-for="Role">Role</label>
            @if (!string.IsNullOrEmpty(Context.Session.GetString("Role")) && Context.Session.GetString("Role")!.Equals("Admin"))
            {
                <select asp-for="Role" class="form-control">
                    <option value="">Select Role</option>
                    <option value="Admin">Admin</option>
                    <option value="User">User</option>
                </select>
            }
            else
            {
                <select asp-for="Role" class="form-control">
                    <option value="">Select Role</option>
                    <option value="User">User</option>
                </select>
            }
            <span asp-validation-for="Role" class="text-danger"></span>
        </div>

        <div class="btn-group-center">
            <button type="submit" class="btn btn-primary-gradient">Create Account</button>
        </div>
        
        <div class="text-center mt-4">
            <span class="muted">Already have an account? </span>
            <a asp-action="Login" class="text-decoration-none" style="color: var(--color-accent); font-weight: 600;">Login</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/jquery.validate.min.js"></script>
    <script src="~/js/jquery.validate.unobtrusive.min.js"></script>
}
