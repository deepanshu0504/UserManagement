@model IEnumerable<LoginandRegisterMVC.Models.Blog>

@{
    ViewData["Title"] = "Blogs";
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var totalBlogs = ViewBag.TotalBlogs as int? ?? 0;
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="gradient-text">Blog Posts</h1>
            <p class="muted">Explore our latest articles and insights</p>
            <hr />
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <h4>No blogs published yet</h4>
            <p>Check back soon for new content!</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var blog in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm blog-card">
                        <img src="~/@blog.FeaturedImage" class="card-img-top" alt="@blog.Title" 
                             style="height: 200px; object-fit: cover;" />
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">
                                <a asp-action="Details" asp-route-id="@blog.BlogId" 
                                   class="text-decoration-none">@blog.Title</a>
                            </h5>
                            <p class="card-text text-muted small mb-2">
                                <i class="bi bi-person"></i> @blog.Author?.Username
                                <span class="ms-3">
                                    <i class="bi bi-calendar"></i> 
                                    @blog.PublishedDate?.ToString("MMM dd, yyyy")
                                </span>
                            </p>
                            <p class="card-text">
                                @(blog.ShortDescription.Length > 150 
                                    ? blog.ShortDescription.Substring(0, 150) + "..." 
                                    : blog.ShortDescription)
                            </p>
                            <div class="mt-auto">
                                <a asp-action="Details" asp-route-id="@blog.BlogId" 
                                   class="btn btn-sm btn-accent">Read More →</a>
                            </div>
                        </div>
                        <div class="card-footer text-muted small">
                            <i class="bi bi-clock"></i> 
                            Last updated: @blog.LastModifiedDate.ToString("MMM dd, yyyy hh:mm tt")
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <nav aria-label="Blog pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)">Previous</a>
                    </li>
                    
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                        </li>
                    }
                    
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

@section Styles {
    <style>
        .blog-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .blog-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(0,0,0,0.2);
        }
    </style>
}

