<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Login Demo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link href="~/css/Site.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script src="~/js/modernizr-2.8.3.js"></script>
</head>
<body class="theme-dark">
    <nav class="navbar navbar-expand-lg navbar-dark navbar-gradient">
        <a class="navbar-brand" asp-controller="Users" asp-action="Index">LOGINDEMO</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Users" asp-action="Index">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Users" asp-action="Login">Login</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Users" asp-action="Register">Signup</a>
                </li>
                @if (Context.Session.GetString("UserId") != null)
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Users" asp-action="Logout">Logout</a>
                    </li>
                }
                <li class="nav-item ms-2">
                    <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">🌙</button>
                </li>
            </ul>
        </div>
    </nav>
    <main class="container body-content">
        @RenderBody()
    </main>
    <footer class="text-center mt-5 mb-4 muted">
        <p class="mb-0">&copy; @DateTime.Now.Year - LoginDemo. Inspired modern theme adaptation.</p>
    </footer>

    <script src="~/js/theme-toggle.js"></script>
    <script src="~/js/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
