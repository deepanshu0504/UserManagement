@model LoginandRegisterMVC.Models.User

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="form-card">
    <h2 class="gradient-text">Login</h2>
    
    <form asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        
        <div class="form-group-modern">
            <label asp-for="UserId">User ID</label>
            <input asp-for="UserId" class="form-control" placeholder="Enter your user ID" />
            <span asp-validation-for="UserId" class="text-danger"></span>
        </div>

        <div class="form-group-modern">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" class="form-control" type="password" placeholder="Enter your password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="btn-group-center">
            <button type="submit" class="btn btn-primary-gradient">Login</button>
        </div>
        
        <div class="text-center mt-4">
            <span class="muted">Don't have an account? </span>
            <a asp-action="Register" class="text-decoration-none" style="color: var(--color-accent); font-weight: 600;">Sign up</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/jquery.validate.min.js"></script>
    <script src="~/js/jquery.validate.unobtrusive.min.js"></script>
}
